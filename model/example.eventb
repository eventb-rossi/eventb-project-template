MACHINE example
SEES
    example_ctx
VARIABLES
    count
INVARIANTS
    @inv1 count ∈ ℕ
    @inv2 count ≤ capacity
EVENTS
    EVENT INITIALISATION
    THEN
        @act1 count ≔ 0
    END

    EVENT increment
    WHERE
        @grd1 count < capacity
    THEN
        @act1 count ≔ count + 1
    END

    EVENT decrement
    WHERE
        @grd1 count > 0
    THEN
        @act1 count ≔ count − 1
    END
END

